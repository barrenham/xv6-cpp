set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR riscv64)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
find_program(XVFS_CXX clang++ REQUIRED)
find_program(XVFS_CC clang REQUIRED)
find_program(XVFS_LD ld.lld REQUIRED)
set(CMAKE_CXX_COMPILER "${XVFS_CXX}")
set(CMAKE_ASM_COMPILER "${XVFS_CC}")
set(CMAKE_CXX_COMPILER_TARGET riscv64-unknown-elf)
set(CMAKE_ASM_COMPILER_TARGET riscv64-unknown-elf)
set(CMAKE_LINKER "${XVFS_LD}")
set(XVFS_COMMON_FLAGS "--no-default-config -march=rv64gc -mabi=lp64d -mcmodel=medany -mno-relax -ffreestanding -fno-builtin -fno-stack-protector -fno-pic -fno-pie")
set(CMAKE_CXX_FLAGS_INIT "${XVFS_COMMON_FLAGS} -fno-exceptions -fno-rtti -fno-threadsafe-statics -fno-use-cxa-atexit -nostdinc++")
set(CMAKE_ASM_FLAGS_INIT "${XVFS_COMMON_FLAGS}")
set(CMAKE_CXX_LINK_EXECUTABLE "<CMAKE_LINKER> <LINK_FLAGS> <OBJECTS> -o <TARGET> <LINK_LIBRARIES>")
