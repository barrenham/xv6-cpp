set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR riscv64)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
find_program(XVFS_CLANG clang REQUIRED)
find_program(XVFS_LLD ld.lld REQUIRED)
set(CMAKE_C_COMPILER "${XVFS_CLANG}")
set(CMAKE_ASM_COMPILER "${XVFS_CLANG}")
set(CMAKE_C_COMPILER_TARGET riscv64-unknown-elf)
set(CMAKE_ASM_COMPILER_TARGET riscv64-unknown-elf)
set(CMAKE_LINKER "${XVFS_LLD}")
set(CMAKE_C_FLAGS_INIT "--no-default-config -march=rv64gc -mabi=lp64d -mcmodel=medany -mno-relax -ffreestanding -fno-builtin -fno-stack-protector -fno-pic -fno-pie")
set(CMAKE_ASM_FLAGS_INIT "--no-default-config -march=rv64gc -mabi=lp64d -mcmodel=medany -mno-relax")
set(CMAKE_C_LINK_EXECUTABLE "<CMAKE_LINKER> <LINK_FLAGS> <OBJECTS> -o <TARGET> <LINK_LIBRARIES>")
