{
  "version": 6,
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "RISC-V Clang / Ninja",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/dev",
      "toolchainFile": "${sourceDir}/cmake/riscv-clang.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "XV_PAGE_ALLOCATOR": "buddy",
        "XV_CPUS": "5",
        "XV_SCHEDULER": "fair"
      }
    },
    {
      "name": "freelist",
      "inherits": "dev",
      "displayName": "RISC-V / free-list allocator",
      "binaryDir": "${sourceDir}/build/freelist",
      "cacheVariables": {
        "XV_PAGE_ALLOCATOR": "freelist"
      }
    },
    {
      "name": "round-robin",
      "inherits": "dev",
      "displayName": "RISC-V / round-robin scheduler",
      "binaryDir": "${sourceDir}/build/round-robin",
      "cacheVariables": {
        "XV_SCHEDULER": "round-robin"
      }
    },
    {
      "name": "mlfq",
      "inherits": "dev",
      "displayName": "RISC-V / mlfq scheduler",
      "binaryDir": "${sourceDir}/build/mlfq",
      "cacheVariables": {
        "XV_SCHEDULER": "mlfq"
      }
    },
    {
      "name": "slab-bitmap",
      "inherits": "dev",
      "displayName": "RISC-V / bitmap object slabs",
      "binaryDir": "${sourceDir}/build/slab-bitmap",
      "cacheVariables": {
        "XV_SLAB_ALLOCATOR": "bitmap"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "freelist",
      "configurePreset": "freelist"
    },
    {
      "name": "round-robin",
      "configurePreset": "round-robin"
    },
    {
      "name": "mlfq",
      "configurePreset": "mlfq"
    },
    {
      "name": "slab-bitmap",
      "configurePreset": "slab-bitmap"
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "freelist",
      "configurePreset": "freelist",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "round-robin",
      "configurePreset": "round-robin",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "mlfq",
      "configurePreset": "mlfq",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "slab-bitmap",
      "configurePreset": "slab-bitmap",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
