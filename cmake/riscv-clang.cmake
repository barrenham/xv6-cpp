set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR riscv64)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
if(NOT DEFINED ENV{CONDA_PREFIX})
  message(FATAL_ERROR "Activate conda OS-LAB before configuring")
endif()
set(XV_TOOL_BIN "$ENV{CONDA_PREFIX}/bin")
set(CMAKE_CXX_COMPILER "${XV_TOOL_BIN}/clang++")
set(CMAKE_ASM_COMPILER "${XV_TOOL_BIN}/clang")
set(CMAKE_CXX_COMPILER_TARGET riscv64-unknown-elf)
set(CMAKE_ASM_COMPILER_TARGET riscv64-unknown-elf)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_CXX_FLAGS_INIT "--no-default-config")
set(CMAKE_ASM_FLAGS_INIT "--no-default-config")
