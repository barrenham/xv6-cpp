  "objective": "Add polymorphic slab allocation inside memory, integrate real small-object consumers, and prove allocation-time/page-call improvements without weakening the fork five-second gate.",
  "requirements": {
    "memory_module": {
      "interface": "kernel/memory/slab/slab_cache.cppm",
      "exported_by": "kernel/memory/memory.cppm"
    },
    "polymorphism": {
      "base": "xv::memory::SlabCache",
      "implementations": [
        "FreeListSlabCache",
        "BitmapSlabCache"
      ],
      "selection": "XV_SLAB_ALLOCATOR=freelist|bitmap; independent of XV_PAGE_ALLOCATOR"
    },
    "production_consumers": [
      "Session",
      "ProcessGroup",
      "ProcessStore registry descriptors",
      "VirtualAddressPool interval nodes"
    ],
    "time_optimization_tests": {
      "native_gate": "7 alternating-order rounds, 100000 allocate/free pairs per round; median at least 10% better than real page allocation",
      "native_matrix": "buddy/freelist physical allocators x freelist/bitmap slab x 64/256/1800-byte objects x zero-empty-retention with a live anchor or one-empty-page reserve",
      "riscv_gate": "5 rounds x 1024 operations, both concrete strategies through the same virtual interface; at least 10% time improvement; exactly one backing-page acquisition"
    },
    "fork_gate": "Unchanged 1000-child workload, 1/5 CPUs x three repeats x two commands, every sample <=5s; standalone command total also <=5s."
  },
