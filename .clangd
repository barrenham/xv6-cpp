CompileFlags:
  CompilationDatabase: build/dev
  Add: [-Wno-unknown-warning-option]
Index:
  Background: Build
---
If:
  PathMatch: (kernel/fs/(devfs|procfs|ramfs|journal|inode|path)/.*|tools/mkfs/.*|tests/(allocator|sync|driver|process|signal|fs|trap|runtime|network|bridge|dhcp|dns|http|tcp)_.*[.]cpp)
CompileFlags:
  CompilationDatabase: build/dev/host

---
Index:
  External:
    File: build/docs/functions.idx
Documentation:
  CommentFormat: Doxygen
---
Index:
  Background: Build

---
If:
  PathMatch: examples/kernel-driver/.*
CompileFlags:
  # Standalone custom commands are absent from the main compilation database.
  # Inferred commands use build/dev as their working directory.
  Add: [-I../../kernel/io]
