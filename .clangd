CompileFlags:
  CompilationDatabase: build/dev
  Add: [-Wno-unknown-warning-option]
Index:
  Background: Build
---
If:
  PathMatch: (tools/mkfs/.*|tests/(allocator|sync|driver|process|signal|fs|trap|runtime|network|bridge|dhcp|dns|http|tcp)_.*[.]cpp)
CompileFlags:
  CompilationDatabase: build/dev/host

---
Index:
  External:
    File: build/docs/functions.idx
Documentation:
  CommentFormat: Doxygen
---
Index:
  Background: Build
